      {
        "fi": "Minä syön kalaa.",
        "en": "I eat fish."
      },
      {
        "fi": "Sinä juot maitoa.",
        "en": "You drink milk."
      },
      {
        "fi": "Hän syö keittoa.",
        "en": "He/She eats soup."
      },
      {
        "fi": "Me juomme mehua.",
        "en": "We drink juice."
      },
      {
        "fi": "He syövät riisiä.",
        "en": "They eat rice."
      }
    ]
  },
  {
