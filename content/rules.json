    "unit": "u01",
    "title": "olla (to be), present tense",
    "examples": [
      { "fi": "Minä olen opiskelija.", "en": "I am a student." },
      { "fi": "Sinä olet kotona.", "en": "You are at home." },
      { "fi": "Hän on opettaja.", "en": "He/She is a teacher." },
      { "fi": "Me olemme Suomessa.", "en": "We are in Finland." },
      { "fi": "Te olette koulussa.", "en": "You (plural) are at school." },
      { "fi": "He ovat kotona.", "en": "They are at home." }
    ]
  },
